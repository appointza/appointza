                    <h1 class="display-3 fw-bold mb-4">Explore Services & Events</h1>
                    <p class="lead fs-3 mb-4">Discover services and exciting events near you</p>
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <div class="input-group input-group-lg">
                                <input type="text" id="searchInput" class="form-control" placeholder="Search services or events..." aria-label="Search">
                                <button class="btn btn-light" type="button" onclick="performSearch()">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Tabs Navigation -->
    <div class="container mb-4">
        <ul class="nav nav-tabs nav-justified" id="exploreTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="services-tab" data-bs-toggle="tab" data-bs-target="#services" type="button" role="tab" aria-controls="services" aria-selected="true">
                    <i class="fas fa-concierge-bell me-2"></i> Services
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="events-tab" data-bs-toggle="tab" data-bs-target="#events" type="button" role="tab" aria-controls="events" aria-selected="false">
