@using appointza.ViewModels

@{
    Layout = "/Views/Shared/_NoSidebarLayout.cshtml";
    ViewData["Title"] = "Explore Services & Events";
    // Base URL configuration (injected by BaseUrlViewDataFilter from appsettings.json)
    var baseUrl = ViewData["BaseUrl"] as string ?? $"{Context.Request.Scheme}:/{Context.Request.Host}";
}

<div class="container-fluid">
    <!-- Hero Section -->
    <div class="row">
        <div class="col-12">
            <div class="hero-section bg-primary text-white py-5 mb-4" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);">
