<style>
    .hero-section {
        border-radius: 15px;
        margin: 20px;
    }
    
    .category-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 15px;
    }
    
    .category-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
    }
    
    .service-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 10px;
    }
    
    .service-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }
    
    .category-icon {
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .card-header {
        border-radius: 10px 10px 0 0 !important;
        border: none !important;
    }
    
    .bg-gradient {
        background: linear-gradient(45deg, #007bff, #0056b3);
    }
    
    .nav-tabs {
        border-bottom: 2px solid #dee2e6;
    }
    
    .nav-tabs .nav-link {
        color: #6c757d;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 1rem 2rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .nav-tabs .nav-link:hover {
        color: #007bff;
        border-bottom-color: #007bff;
    }
    
    .nav-tabs .nav-link.active {
        color: #007bff;
        background-color: transparent;
        border-bottom-color: #007bff;
        font-weight: 600;
    }
    
    .event-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 15px;
        overflow: hidden;
    }
    
    .event-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }
    
    .event-image {
        height: 200px;
        object-fit: cover;
        width: 100%;
    }

    /* Mobile Responsive Styles */
    @@media (max-width: 768px) {
        .hero-section {
            padding: 2rem 1rem !important;
            margin: 10px !important;
        }

        .hero-section h1.display-3 {
            font-size: 2.5rem;
        }

        .hero-section .lead {
            font-size: 1.25rem;
        }

        /* Scrollable Tabs */
        .nav-tabs {
            flex-wrap: nowrap;
            overflow-x: auto;
            white-space: nowrap;
            border-bottom: 2px solid #dee2e6;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 5px; /* Space for scrollbar */
        }

        .nav-tabs .nav-item {
            display: inline-block;
        }

        .nav-tabs .nav-link {
            padding: 0.75rem 1.25rem;
        }
    }
</style>

<script>
    const baseUrl = '@baseUrl';
    let currentTab = 'services';
    
    // Load events when events tab is clicked
    document.addEventListener('DOMContentLoaded', function() {
        const eventsTab = document.getElementById('events-tab');
        if (eventsTab) {
            eventsTab.addEventListener('shown.bs.tab', function() {
                currentTab = 'events';
                loadEvents();
            });
        }
        
        const servicesTab = document.getElementById('services-tab');
        if (servicesTab) {
            servicesTab.addEventListener('shown.bs.tab', function() {
                currentTab = 'services';
            });
        }
        
        // Load events on page load if events tab is active
        const activeTab = document.querySelector('.nav-link.active');
        if (activeTab && activeTab.id === 'events-tab') {
            loadEvents();
        }
    });
    
    function performSearch() {
        const searchTerm = document.getElementById('searchInput').value;
        if (currentTab === 'services') {
            // Filter services
            filterServices(searchTerm);
        } else {
            // Filter events
            filterEvents(searchTerm);
        }
    }
    
    function filterServices(searchTerm) {
        const serviceCards = document.querySelectorAll('#services .service-card, #services .category-card');
        serviceCards.forEach(card => {
            const text = card.textContent.toLowerCase();
            if (text.includes(searchTerm.toLowerCase())) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
    
    function filterEvents(searchTerm) {
        const eventCards = document.querySelectorAll('#eventsContainer .event-card');
        eventCards.forEach(card => {
            const text = card.textContent.toLowerCase();
            if (text.includes(searchTerm.toLowerCase())) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
    
    async function loadEvents() {
        const eventsContainer = document.getElementById('eventsContainer');
        const eventsLoading = document.getElementById('eventsLoading');
        const noEventsMessage = document.getElementById('noEventsMessage');
        
        try {
            eventsLoading.style.display = 'block';
            eventsContainer.style.display = 'none';
            noEventsMessage.style.display = 'none';
            
            // Fetch events from API
            const response = await fetch(`${baseUrl}/api/Event/Select`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    item: {
                        id: 0,
                        organisation_id: 0,
                        organisation_location_id: 0,
                        status: "",
                        is_public: true
                    }
                })
            });
            
            if (!response.ok) {
                throw new Error('Failed to load events');
            }
            
            const result = await response.json();
            const events = result.item || [];
            
            // Filter active, public events
            const activeEvents = events.filter(e => 
                e.isactive && 
                e.is_public && 
                e.status !== 'cancelled' && 
                e.status !== 'completed'
            );
            
            eventsLoading.style.display = 'none';
            
            if (activeEvents.length === 0) {
                noEventsMessage.style.display = 'block';
                return;
            }
            
            // Render events
            eventsContainer.innerHTML = activeEvents.map(event => createEventCard(event)).join('');
            eventsContainer.style.display = 'flex';
            
        } catch (error) {
            console.error('Error loading events:', error);
            eventsLoading.style.display = 'none';
            noEventsMessage.style.display = 'block';
            noEventsMessage.innerHTML = `
                <i class="fas fa-exclamation-triangle fa-4x text-warning mb-3"></i>
                <h4>Error Loading Events</h4>
                <p class="text-muted">Please try again later</p>
            `;
        }
    }
    
    function createEventCard(event) {
        const eventDate = event.event_date 
            ? new Date(event.event_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
            : event.from_date && event.to_date
            ? `${new Date(event.from_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} - ${new Date(event.to_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`
            : 'Date TBA';
        
        const imageUrl = event.images?.ImageIds && event.images.ImageIds.length > 0
            ? `${baseUrl}/api/Files/get?id=${event.images.ImageIds[0]}`
            : '';
        
        const remainingSlots = event.remainingslot || 0;
        const totalSlots = event.slot_limit || 0;
        const entryAmount = event.entry_amount || 0;
        
        return `
            <div class="col-md-6 col-lg-4">
                <div class="card event-card h-100 border-0 shadow">
                    ${imageUrl ? `
                        <img src="${imageUrl}" class="event-image" alt="${event.event_name || 'Event'}" onerror="this.style.display='none'">
                    ` : `
                        <div class="event-image bg-gradient text-white d-flex align-items-center justify-content-center">
                            <i class="fas fa-calendar-alt fa-4x"></i>
                        </div>
                    `}
                    <div class="card-body">
                        <h5 class="card-title">${event.event_name || 'Untitled Event'}</h5>
                        <p class="card-text text-muted">${event.description || 'No description available'}</p>
                        <div class="mb-3">
                            <p class="mb-1"><i class="fas fa-calendar me-2 text-primary"></i><strong>Date:</strong> ${eventDate}</p>
                            ${event.location ? `<p class="mb-1"><i class="fas fa-map-marker-alt me-2 text-danger"></i><strong>Location:</strong> ${event.location}</p>` : ''}
                            ${remainingSlots > 0 ? `<p class="mb-1"><i class="fas fa-users me-2 text-success"></i><strong>Slots:</strong> ${remainingSlots} / ${totalSlots} available</p>` : '<p class="mb-1 text-danger"><i class="fas fa-times-circle me-2"></i>Fully Booked</p>'}
                            ${entryAmount > 0 ? `<p class="mb-1"><i class="fas fa-rupee-sign me-2 text-warning"></i><strong>Entry:</strong> ₹${entryAmount}</p>` : '<p class="mb-1 text-success"><i class="fas fa-gift me-2"></i>Free Entry</p>'}
                        </div>
                        <a href="${baseUrl}/user/events/${event.id}/book" class="btn btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>View Details
                        </a>
                    </div>
                </div>
            </div>
        `;
    }
    
    // Allow Enter key to trigger search
    document.getElementById('searchInput')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            performSearch();
        }
    });
</script>
