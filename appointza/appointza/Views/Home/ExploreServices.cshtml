        </ul>
    </div>
    
    <!-- Tab Content -->
    <div class="tab-content" id="exploreTabContent">
        <!-- Services Tab -->
        <div class="tab-pane fade show active" id="services" role="tabpanel" aria-labelledby="services-tab">
    
    <div class="container">
        <!-- Service Categories -->
