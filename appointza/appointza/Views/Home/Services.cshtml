<script>
    let currentTab = '@activeTab';
    
    function setActiveTab(tab) {
        currentTab = tab;
        // Update URL without reload
        const url = new URL(window.location);
        url.searchParams.set('tab', tab);
        window.history.pushState({}, '', url);
    }
    
    function toggleFilters(tab) {
        const panelId = tab + 'FiltersPanel';
        const panel = document.getElementById(panelId);
        const btn = document.getElementById(tab + 'FilterBtn');
        
        if (panel && btn) {
            const isVisible = panel.classList.contains('show');
            if (isVisible) {
                panel.classList.remove('show');
                btn.classList.remove('active');
            } else {
                // Close all other panels
                document.querySelectorAll('.filters-panel').forEach(p => p.classList.remove('show'));
                document.querySelectorAll('.filter-toggle-btn').forEach(b => b.classList.remove('active'));
                
                panel.classList.add('show');
                btn.classList.add('active');
            }
        }
    }
    
    function selectPrimaryType(typeId, tab) {
        const url = new URL(window.location);
        url.searchParams.set('tab', tab);
        url.searchParams.set('primaryType', typeId);
        url.searchParams.delete('secondaryType');
        window.location.href = url.toString();
    }
    
    function selectSecondaryType(typeId, tab) {
        const url = new URL(window.location);
        url.searchParams.set('tab', tab);
        url.searchParams.set('secondaryType', typeId);
        window.location.href = url.toString();
    }
    
    function clearAllFilters(tab) {
        const url = new URL(window.location);
        url.searchParams.set('tab', tab);
        url.searchParams.delete('search');
        url.searchParams.delete('primaryType');
        url.searchParams.delete('secondaryType');
        window.location.href = url.toString();
    }
    
    function clearSearch(tab) {
        const url = new URL(window.location);
        url.searchParams.set('tab', tab);
        url.searchParams.delete('search');
        window.location.href = url.toString();
    }
    
    function refreshResults() {
        window.location.reload();
    }
    
    // Initialize Bootstrap tabs
    document.addEventListener('DOMContentLoaded', function() {
        // Tab switching
        const tabButtons = document.querySelectorAll('[data-bs-toggle="tab"]');
        tabButtons.forEach(button => {
            button.addEventListener('shown.bs.tab', function (e) {
                const tabId = e.target.getAttribute('data-bs-target').replace('#', '').replace('-content', '');
                setActiveTab(tabId);
            });
        });
    });
</script>
